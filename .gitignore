# --- Secrets -------------------------------------------------------------
.env
.streamlit/secrets.toml

# --- Virtual environment -------------------------------------------------
.venv/
venv/
env/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter -------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Generated fine-tuning data ------------------------------------------
# Derived from data/sms_conversations.json by scripts/run_finetuning.py.
# Never committed: a JSONL built from the wrong split silently invalidates
# the evaluation (see CLAUDE.md section 11).
data/*.jsonl

# --- Cached LLM predictions ----------------------------------------------
data/cache/

# --- Persisted Chroma database -------------------------------------------
# Chroma pre-allocates its HNSW index for 10,000 vectors, so it writes ~60 MB
# for our three chunks. data/vector_store.json holds the same chunks and
# embeddings in ~20 KB and IS committed; the retriever rebuilds this directory
# from it on a fresh checkout. See app/modules/embedding/indexer.py.
data/chroma/

# --- IDE / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Deliberately NOT ignored --------------------------------------------
# data/tech.db            generated by scripts/seed_database.py
# data/vector_store.json  generated by scripts/build_vector_store.py
# Both must ship in the repo: Streamlit Community Cloud cannot run the
# offline steps. See CLAUDE.md section 5.
