# --- Generated fine-tuning data ------------------------------------------
# Derived from data/sms_conversations.json by scripts/run_finetuning.py.
# Never committed: a JSONL built from the wrong split silently invalidates
# the evaluation (see CLAUDE.md section 11).
data/*.jsonl

# --- Cached LLM predictions ----------------------------------------------
data/cache/

