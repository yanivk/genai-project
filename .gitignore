.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Deliberately NOT ignored --------------------------------------------
# data/tech.db      generated by scripts/seed_database.py
# data/chroma/      generated by scripts/build_vector_store.py
