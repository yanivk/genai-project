# Copy this file to .env and fill in your values.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env is gitignored. Never commit a real API key.
# On Streamlit Community Cloud, set these in the app's Secrets UI instead —
# app/config.py reads st.secrets first, then falls back to these env vars.

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat model used by the main agent and the advisors.
OPENAI_MODEL=gpt-4o-2024-11-20

# Embedding model. Must be identical for indexing and querying.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Fine-tuning ---------------------------------------------------------
# Base model for the Exit Advisor fine-tuning job.
FT_BASE_MODEL=gpt-4o-mini-2024-07-18

# Fine-tuned model id, e.g. ft:gpt-4o-mini-2024-07-18:org::AbCdEfGh
# Leave empty until scripts/run_finetuning.py completes. While empty, the
# Exit Advisor falls back to OPENAI_MODEL with few-shot prompting.
FT_EXIT_ADVISOR_MODEL=

# --- Database ------------------------------------------------------------
# SQLAlchemy URL. Relative paths resolve against the repository root.
DB_URL=sqlite:///data/tech.db

# --- Vector store --------------------------------------------------------
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=python_dev_job

# --- Orchestration -------------------------------------------------------
# Max advisor consultation rounds per turn, so a turn cannot loop forever.
MAX_ADVISOR_ROUNDS=2
